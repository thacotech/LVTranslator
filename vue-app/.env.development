# Development Environment Configuration

# Environment
VITE_APP_ENV=development
NODE_ENV=development

# Development Features
VITE_ENABLE_DEBUG=true
VITE_ENABLE_CONSOLE_LOGS=true
VITE_ENABLE_SOURCEMAPS=true
VITE_ENABLE_HMR=true

# Development API Settings
VITE_API_TIMEOUT=30000
VITE_ENABLE_API_MOCKING=false

# Performance (Relaxed for development)
VITE_CHUNK_SIZE_WARNING_LIMIT=1000
VITE_ENABLE_COMPRESSION=false

# Development Server
VITE_DEV_SERVER_PORT=3000
VITE_DEV_SERVER_HOST=localhost
VITE_DEV_SERVER_OPEN=true

# Analytics (Disabled in development)
VITE_ENABLE_ANALYTICS=false
VITE_GOOGLE_ANALYTICS_ID=

# Security (Relaxed for development)
VITE_ENABLE_CSP=false
VITE_ENABLE_HTTPS_ONLY=false