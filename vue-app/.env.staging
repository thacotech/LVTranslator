# Staging Environment Configuration

# Environment
VITE_APP_ENV=staging
NODE_ENV=production

# Staging Features (Mix of development and production)
VITE_ENABLE_DEBUG=true
VITE_ENABLE_CONSOLE_LOGS=true
VITE_ENABLE_SOURCEMAPS=true
VITE_ENABLE_HMR=false

# Staging API Settings
VITE_API_TIMEOUT=20000
VITE_ENABLE_API_MOCKING=false

# Performance (Moderate for staging)
VITE_CHUNK_SIZE_WARNING_LIMIT=750
VITE_ENABLE_COMPRESSION=true
VITE_ENABLE_CACHING=true
VITE_CACHE_MAX_AGE=86400

# Build Optimizations (Moderate)
VITE_ENABLE_TREE_SHAKING=true
VITE_ENABLE_MINIFICATION=true
VITE_DROP_CONSOLE=false
VITE_DROP_DEBUGGER=true

# Analytics (Testing in staging)
VITE_ENABLE_ANALYTICS=true
VITE_GOOGLE_ANALYTICS_ID=

# Security (Moderate for staging)
VITE_ENABLE_CSP=true
VITE_ENABLE_HTTPS_ONLY=false
VITE_ENABLE_HSTS=false

# Testing Features
VITE_ENABLE_TEST_MODE=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Error Reporting (Testing)
VITE_SENTRY_DSN=
VITE_ENABLE_ERROR_REPORTING=true