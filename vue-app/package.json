{
  "name": "lvtranslator-vue",
  "version": "2.0.0",
  "description": "Vietnamese ↔ Lao Translator with Vue.js and Ant Design Vue",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "npm run type-check && npm run build:prod",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "build:staging": "vite build --mode staging",
    "build:analyze": "npm run build:prod && npm run analyze",
    "preview": "vite preview",
    "preview:prod": "npm run build:prod && vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .gitignore",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "analyze": "npx serve dist -s -l 8080 & sleep 2 && open http://localhost:8080/stats.html",
    "optimize": "node scripts/build-optimize.js",
    "build:optimized": "npm run build:prod && npm run optimize",
    "clean": "rm -rf dist node_modules/.vite",
    "prepare": "npm run type-check && npm run lint:check && npm run format:check",
    "postbuild": "npm run optimize"
  },
  "dependencies": {
    "@google/generative-ai": "^0.1.3",
    "ant-design-vue": "^4.0.8",
    "dompurify": "^3.0.6",
    "lz-string": "^1.5.0",
    "mammoth": "^1.6.0",
    "pdfjs-dist": "^3.11.174",
    "pinia": "^2.1.7",
    "vue": "^3.3.8",
    "vue-i18n": "^9.8.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.15.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.10.4",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-vue": "^4.5.2",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.3",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.19.2",
    "fast-check": "^3.15.0",
    "jsdom": "^23.0.1",
    "prettier": "^3.1.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "typescript": "~5.4.0",
    "vite": "^5.0.0",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^1.0.4",
    "vue-tsc": "^1.8.25"
  }
}
